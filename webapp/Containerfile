FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
# USER root

RUN microdnf -y update && \
    microdnf --disableplugin subscription-manager -y install vim gcc python3-devel python3-pip libglvnd-glx && \
    microdnf clean all

WORKDIR /app
COPY . ./
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

WORKDIR /app/src
CMD ["python", "app.py"]